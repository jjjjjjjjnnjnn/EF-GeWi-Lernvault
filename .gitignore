# Obsidian 系统文件（不同步个人工作区状态）
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/hotkeys.json

# Obsidian 回收站 / 附件缓存
.trash/
.obsidian/plugins/*/data.json

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 本地批量下载区（大PDF/视频，不进git，只留清单进仓库）
_Downloads/

# DeepTutor runtime（家目录必须在vault外，见00_META/DeepTutor.md；误建的data/永不提交）
data/
deeptutor-data/

# Anki 构建产物（只同步来源 csv/md，不同步 apkg 二进制）
*.apkg
*.colpkg

# Python / Node（如后期加脚本）
__pycache__/
node_modules/

# App-EF-Lernvault 构建产物（源码进git，产物/密钥不进）
App-EF-Lernvault/dist/
App-EF-Lernvault/src-tauri/target/
App-EF-Lernvault/src-tauri/*.key
App-EF-Lernvault/src-tauri/*.pub
*.msi
*.exe
!**/tools/*.exe
App-EF-Lernvault/*.tsbuildinfo
